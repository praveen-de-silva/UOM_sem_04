let 
    oddEven n = (n - (n/2) * 2) eq 1 -> 'Odd' | 'Even' and
    rec oddEvenRec n = 
        n eq 1 -> 'Odd'
        | n eq 0 -> 'Even'
        | oddEvenRec (n-2)
in Print(oddEven 12, oddEvenRec 12)